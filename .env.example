# Copia este archivo a .env (en la raíz del repo) y ajusta los valores.

# PostgreSQL de docker-compose (puerto 5433). Si usas un PostgreSQL local, cambia usuario/clave/puerto.
DATABASE_URL="postgresql://bmb:bmb@localhost:5433/buildmybox?schema=public"

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Token del panel de administración (MVP). ¡Cámbialo fuera de desarrollo!
ADMIN_TOKEN=admin-demo

# Pasarela de pagos: mock (simulada) | stripe (no implementada aún)
PAYMENT_PROVIDER=mock
