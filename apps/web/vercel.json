{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api-production-ca1f.up.railway.app/api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
